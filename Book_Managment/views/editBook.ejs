<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Book</title>
</head>
<body>
    <div class="container" align="center">
        <h2>Edit Book Information</h2>

        <form action="/update-book/<%= book._id %>" method="post" enctype="multipart/form-data">
            <table border="1" cellpadding="5">
                <tr>
                    <td>Title:</td>
                    <td><input type="text" name="Title" value="<%= book.Title %>"></td>
                </tr>
                <tr>
                    <td>Description:</td>
                    <td><input type="text" name="Description" value="<%= book.Description %>"></td>
                </tr>
                <tr>
                    <td>Price:</td>
                    <td><input type="number" name="Price" value="<%= book.Price %>"></td>
                </tr>
                <tr>
                    <td><label>Category:</label></td>
                        <td><select name="category" required>
                            <option value="" disabled>Select Any One</option>
                            <option value="Travel" <%= book.category === "Travel" ? "selected" : "" %>>Travel</option>
                            <option value="Horror" <%= book.category === "Horror" ? "selected" : "" %>>Horror</option>
                            <option value="History" <%= book.category === "History" ? "selected" : "" %>>History</option>
                            <option value="Fantasy" <%= book.category === "Fantasy" ? "selected" : "" %>>Fantasy</option>
                        </select>
                    </td>
                </tr>
                <tr>
                    <td>Image:</td>
                    <td><input type="file" name="Image">
                        <img src="/uploads/<%= book.Image %>" height="50" >
                    </td>
                </tr>
                <tr>
                    <td></td>
                    <td><input type="submit" value="Update Book"></td>
                </tr>
            </table>
        </form>

    </div>
</body>
</html>